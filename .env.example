# Firebase config (from Project settings > General > Your apps > SDK setup and configuration)
# These are safe to expose client-side — Firestore security rules are what actually protect the data.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=

# App Check (reCAPTCHA Enterprise site key) — created in Google Cloud Console
# (console.cloud.google.com/security/recaptcha), then registered against this
# app in Firebase Console > App Check. Requires the project to be on the
# Blaze plan (billing linked) since reCAPTCHA Enterprise needs the API
# enabled. Also safe to expose client-side; it identifies the site, not a
# secret — there's no separate secret key to manage for this provider.
PUBLIC_RECAPTCHA_SITE_KEY=
