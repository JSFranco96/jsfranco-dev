---
import '@fontsource/archivo/500.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/900.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Javier Steven Franco Ospina — Full-Stack Developer',
  description = 'Full-Stack Developer con +9 años de experiencia en Angular, Node.js, TypeScript, MongoDB y AWS. Construyendo aplicaciones web y móviles escalables.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://jsfranco.dev');
const ogImage = new URL('/og-image.png', 'https://jsfranco.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Javier Steven Franco Ospina" />
    <meta name="theme-color" content="#f7f7f5" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="alternate icon" href="/favicon.ico" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Javier Steven Franco Ospina',
      jobTitle: 'Full-Stack Developer',
      url: 'https://jsfranco.dev',
      sameAs: ['https://www.linkedin.com/in/jsfranco-dev'],
      knowsAbout: ['Angular', 'Node.js', 'TypeScript', 'MongoDB', 'AWS', 'Firebase', 'NestJS', 'Docker'],
    })} />

    <script is:inline>
      // Blocking (non-deferred) by design: sets data-theme before first paint
      // so there's no flash of the wrong theme's colors.
      (function () {
        var theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', theme === 'dark' ? '#111111' : '#f7f7f5');
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      // Always run this, regardless of `CSS.supports('animation-timeline: view()')`.
      // Some mobile browsers report support but still fail to animate once the
      // dynamic URL bar resizes the real viewport mid-scroll, leaving sections
      // stuck invisible. This acts as a safety net on top of the native animation.
      const revealEls = document.querySelectorAll('.reveal, .reveal-scale');

      if (revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -5% 0px' }
        );

        revealEls.forEach((el) => io.observe(el));
      }
    </script>

    <script>
      import { translations, type Lang } from '../i18n/translations';

      type Dict = (typeof translations)['es'];

      function get(dict: Dict, path: string): string | undefined {
        const value = path.split('.').reduce<unknown>((acc, key) => {
          if (acc == null || typeof acc !== 'object') return undefined;
          return (acc as Record<string, unknown>)[key];
        }, dict);
        return typeof value === 'string' ? value : undefined;
      }

      function currentLang(): Lang {
        return localStorage.getItem('lang') === 'en' ? 'en' : 'es';
      }

      function applyLanguage(lang: Lang) {
        const dict = translations[lang];
        document.documentElement.lang = lang;

        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const value = get(dict, el.dataset.i18n ?? '');
          if (value !== undefined) el.textContent = value;
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-placeholder]').forEach((el) => {
          const value = get(dict, el.dataset.i18nPlaceholder ?? '');
          if (value !== undefined) el.setAttribute('placeholder', value);
        });

        document.querySelectorAll<HTMLElement>('[data-i18n-aria-label]').forEach((el) => {
          const value = get(dict, el.dataset.i18nAriaLabel ?? '');
          if (value !== undefined) el.setAttribute('aria-label', value);
        });

        const titleEl = document.querySelector('title');
        if (titleEl) titleEl.textContent = dict.meta.title;
        const descEl = document.querySelector('meta[name="description"]');
        if (descEl) descEl.setAttribute('content', dict.meta.description);
        const ogDescEl = document.querySelector('meta[property="og:description"]');
        if (ogDescEl) ogDescEl.setAttribute('content', dict.meta.description);
        const twitterDescEl = document.querySelector('meta[name="twitter:description"]');
        if (twitterDescEl) twitterDescEl.setAttribute('content', dict.meta.description);

        document.querySelectorAll<HTMLElement>('.lang-toggle [data-lang-code]').forEach((el) => {
          el.textContent = lang === 'es' ? 'EN' : 'ES';
        });
      }

      applyLanguage(currentLang());

      document.querySelectorAll('.lang-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next: Lang = currentLang() === 'es' ? 'en' : 'es';
          localStorage.setItem('lang', next);
          applyLanguage(next);
        });
      });

      const THEME_COLORS = { dark: '#111111', light: '#f7f7f5' };

      function currentTheme(): 'dark' | 'light' {
        return localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
      }

      function applyTheme(theme: 'dark' | 'light') {
        document.documentElement.setAttribute('data-theme', theme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[theme]);
      }

      document.querySelectorAll('.theme-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = currentTheme() === 'dark' ? 'light' : 'dark';
          localStorage.setItem('theme', next);
          applyTheme(next);
        });
      });
    </script>
  </body>
</html>
