---
const core = [
  { label: 'Angular' },
  { label: 'Node.js' },
  { label: 'TypeScript' },
  { label: 'MongoDB' },
  { label: 'AWS' },
  { label: 'Firebase' },
];

const learning = ['Swift', 'Kotlin'];
---

<section id="skills" class="mx-auto max-w-6xl border-b-2 border-border px-6 py-24 sm:py-32">
  <div class="reveal flex flex-col gap-2" style="--stagger: 0">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-sm font-bold text-accent">04</span>
      <span class="font-mono text-sm font-medium tracking-[0.3em] text-muted uppercase" data-i18n="skills.eyebrow">Skills</span>
    </div>
    <h2 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl" data-i18n="skills.title">
      Tecnologías con las que trabajo
    </h2>
  </div>

  <div class="mt-14 border-y-2 border-border">
    {
      core.map((skill, i) => (
        <div
          class="reveal group grid grid-cols-[56px_1fr_auto] items-center gap-4 border-b border-border-soft px-2 py-5 transition-colors duration-300 last:border-b-0 hover:bg-bg-soft sm:px-4"
          style={`--stagger: ${i + 1}`}
        >
          <span class="font-mono text-base font-bold text-accent transition-transform duration-300 group-hover:translate-x-1">0{i + 1}</span>
          <span class="text-xl font-bold text-text sm:text-2xl">{skill.label}</span>
          <span class="font-mono text-xs tracking-[0.15em] text-muted uppercase">Core</span>
        </div>
      ))
    }
  </div>

  <div class="reveal mt-8 flex flex-col gap-3" style="--stagger: 7">
    <span class="font-mono text-sm tracking-[0.25em] text-muted uppercase" data-i18n="skills.learningLabel">
      Incursionando en desarrollo móvil nativo
    </span>
    <div class="flex flex-wrap gap-3">
      {
        learning.map((skill) => (
          <div class="flex items-center gap-3 border border-dashed border-border px-4 py-2.5">
            <span class="text-base font-bold text-text">{skill}</span>
            <span class="font-mono text-xs tracking-wide text-accent uppercase" data-i18n="skills.learningTag">
              En aprendizaje
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
