---
const items = [
  {
    period: 'Frontend & Cloud',
    title: 'Liderazgo en plataformas de e-commerce',
    description:
      'Lideré el desarrollo frontend de plataformas de e-commerce personalizadas, usando Angular junto a herramientas cloud como Firebase para construir experiencias de compra rápidas y confiables.',
  },
  {
    period: 'Modernización',
    title: 'Migración de proyectos Angular legados',
    description:
      'Modernicé proyectos Angular heredados, mejorando el rendimiento y la mantenibilidad del código mediante actualización de dependencias, refactors incrementales y mejores prácticas de arquitectura.',
  },
  {
    period: 'Liderazgo técnico',
    title: 'Gestión de proyectos end-to-end',
    description:
      'Supervisé proyectos de desarrollo de software de principio a fin, mentorizando desarrolladores junior e implementando procesos de code review para elevar la calidad del equipo.',
  },
];
---

<section id="experience" class="mx-auto max-w-4xl px-6 py-28 sm:py-36">
  <div class="reveal" style="--stagger: 0">
    <span class="font-display text-sm tracking-[0.3em] text-electric uppercase">Experiencia</span>
    <h2 class="mt-4 font-display text-3xl font-bold tracking-tight sm:text-4xl">
      Hitos que marcaron mi camino
    </h2>
  </div>

  <ol class="mt-16 space-y-12 border-l border-border pl-8 sm:pl-10">
    {
      items.map((item, i) => (
        <li class="reveal relative" style={`--stagger: ${i + 1}`}>
          <span class="absolute top-1.5 -left-[2.6rem] h-3 w-3 rounded-full bg-gradient-to-br from-electric to-mint shadow-[0_0_0_4px_#0a0a0a] sm:-left-[3.15rem]" />
          <p class="font-display text-xs tracking-[0.25em] text-mint uppercase">{item.period}</p>
          <h3 class="mt-2 font-display text-xl font-semibold text-text sm:text-2xl">
            {item.title}
          </h3>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted">{item.description}</p>
        </li>
      ))
    }
  </ol>
</section>
