---
const projects = [
  {
    title: 'Proyecto Próximamente',
    tag: 'Web App',
    description: 'Un nuevo caso de estudio está en camino. Vuelve pronto para ver los detalles.',
  },
  {
    title: 'Proyecto Próximamente',
    tag: 'Mobile App',
    description: 'Explorando Swift y Kotlin en una nueva aplicación móvil nativa.',
  },
  {
    title: 'Proyecto Próximamente',
    tag: 'Cloud / AWS',
    description: 'Una arquitectura cloud-first, documentada de principio a fin.',
  },
];
---

<section id="projects" class="mx-auto max-w-6xl border-b-2 border-border px-6 py-24 sm:py-32">
  <div class="reveal flex flex-col gap-2" style="--stagger: 0">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-sm font-bold text-accent">03</span>
      <span class="font-mono text-sm font-medium tracking-[0.3em] text-muted uppercase" data-i18n="projects.eyebrow">Proyectos</span>
    </div>
    <h2 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl" data-i18n="projects.title">
      Trabajo seleccionado
    </h2>
    <p class="mt-3 max-w-xl text-lg text-muted" data-i18n="projects.intro">
      Estoy preparando estudios de caso detallados de mis proyectos recientes. Mientras tanto,
      aquí tienes un adelanto de lo que viene.
    </p>
  </div>

  <div class="mt-14 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, i) => (
        <article
          class="reveal-scale group flex flex-col bg-bg transition-colors duration-300 hover:bg-bg-soft"
          style={`--stagger: ${i + 1}`}
        >
          <div class="flex aspect-video items-center justify-center border-b-2 border-border">
            <svg
              class="h-10 w-10 text-muted transition-transform duration-500 group-hover:translate-x-1 group-hover:text-accent"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
            >
              <path d="M8 9l-4 3 4 3M16 9l4 3-4 3M13 6l-2 12" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <div class="flex flex-1 flex-col gap-2 p-6">
            <span class="font-mono text-xs tracking-[0.2em] text-accent uppercase" data-i18n={`projects.items.${i}.tag`}>
              {project.tag}
            </span>
            <h3 class="text-xl font-bold text-text" data-i18n={`projects.items.${i}.title`}>{project.title}</h3>
            <p class="text-base leading-relaxed text-muted" data-i18n={`projects.items.${i}.description`}>{project.description}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>
