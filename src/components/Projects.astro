---
import { projects } from '../data/projects';
import { translations } from '../i18n/translations';

const t = translations.es.projects;
---

<section id="projects" class="mx-auto max-w-6xl border-b-2 border-border px-6 py-24 sm:py-32">
  <div class="reveal flex flex-col gap-2" style="--stagger: 0">
    <div class="flex items-baseline gap-4">
      <span class="font-mono text-sm font-bold text-accent">03</span>
      <span class="font-mono text-sm font-medium tracking-[0.3em] text-muted uppercase" data-i18n="projects.eyebrow">{t.eyebrow}</span>
    </div>
    <h2 class="mt-2 text-4xl font-black tracking-tight sm:text-5xl" data-i18n="projects.title">{t.title}</h2>
    <p class="mt-3 max-w-xl text-lg text-muted" data-i18n="projects.intro">{t.intro}</p>
  </div>

  <div class="mt-14 grid gap-px border-2 border-border bg-border md:grid-cols-2 lg:grid-cols-3">
    {
      projects.map((project, i) => (
        <a
          href={`/proyectos/${project.slug}`}
          class:list={[
            'reveal-scale group flex flex-col gap-5 bg-bg p-8 transition-colors duration-300 hover:bg-bg-soft sm:p-10',
            i === projects.length - 1 && projects.length % 2 === 1 && 'md:max-lg:col-span-2',
          ]}
          style={`--stagger: ${i + 1}`}
        >
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <span class="font-mono text-xs tracking-[0.2em] text-accent uppercase" data-i18n={`projects.items.${i}.tag`}>
              {t.items[i].tag}
            </span>
            <span class="border border-border px-2 py-1 font-mono text-xs tracking-wide text-muted uppercase" data-i18n={`projects.items.${i}.status`}>
              {t.items[i].status}
            </span>
          </div>

          <h3 class="text-4xl font-black tracking-tight text-text" data-i18n={`projects.items.${i}.title`}>
            {t.items[i].title}
          </h3>
          <p class="text-lg leading-relaxed text-muted" data-i18n={`projects.items.${i}.description`}>{t.items[i].description}</p>

          <ul class="flex flex-wrap gap-2">
            {project.stack.map((tech) => (
              <li class="border border-border-soft px-2 py-1 font-mono text-xs text-muted">{tech}</li>
            ))}
          </ul>

          <span class="mt-auto flex items-center gap-2 pt-2 font-bold text-text transition-colors duration-300 group-hover:text-accent">
            <span data-i18n="projects.caseStudyCta">{t.caseStudyCta}</span>
            <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </a>
      ))
    }
  </div>
</section>
