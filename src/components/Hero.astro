<section
  id="top"
  class="relative flex min-h-screen items-center overflow-hidden px-6 pt-24"
>
  <div class="hero-parallax pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute -top-32 -left-32 h-96 w-96 rounded-full bg-electric/25 blur-[110px]"
    >
    </div>
    <div
      class="absolute right-[-6rem] bottom-[-4rem] h-[28rem] w-[28rem] rounded-full bg-mint/15 blur-[130px]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,var(--grid-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--grid-line)_1px,transparent_1px)] bg-[size:64px_64px] [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,#000_10%,transparent_75%)]"
    >
    </div>
  </div>

  <div class="mx-auto max-w-4xl">
    <p
      class="hero-in font-display text-sm tracking-[0.3em] text-mint uppercase"
      style="--stagger: 0"
      data-i18n="hero.eyebrow"
    >
      Full-Stack Developer
    </p>

    <h1
      class="hero-in mt-6 font-display text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl"
      style="--stagger: 1"
    >
      Javier Steven<br />
      <span class="text-gradient">Franco Ospina</span>
    </h1>

    <p
      class="hero-in mt-6 max-w-2xl text-lg text-muted sm:text-xl"
      style="--stagger: 2"
      data-i18n="hero.tagline"
    >
      Construyo aplicaciones web y móviles escalables — de la interfaz a la nube —
      con Angular, Node.js, TypeScript y AWS. Más de 8 años convirtiendo
      requerimientos complejos en productos sólidos y fáciles de mantener.
    </p>

    <div class="hero-in mt-10 flex flex-wrap gap-4" style="--stagger: 3">
      <a
        href="#projects"
        class="rounded-full bg-text px-6 py-3 text-sm font-medium text-bg transition-transform duration-300 hover:scale-105"
        data-i18n="hero.ctaProjects"
      >
        Ver proyectos
      </a>
      <a
        href="#contact"
        class="rounded-full border border-border px-6 py-3 text-sm font-medium text-text transition-colors duration-300 hover:border-electric hover:text-electric"
        data-i18n="hero.ctaContact"
      >
        Hablemos
      </a>
    </div>
  </div>

  <div
    class="hero-in absolute bottom-10 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 sm:flex"
    style="--stagger: 4"
  >
    <span class="text-xs tracking-[0.3em] text-muted uppercase" data-i18n="hero.scroll">Scroll</span>
    <span class="h-10 w-px animate-pulse bg-gradient-to-b from-mint to-transparent"></span>
  </div>
</section>
