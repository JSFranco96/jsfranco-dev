---
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';

const links = [
  { href: '#about', key: 'nav.about', label: 'Sobre mí' },
  { href: '#experience', key: 'nav.experience', label: 'Experiencia' },
  { href: '#skills', key: 'nav.skills', label: 'Skills' },
  { href: '#contact', key: 'nav.contact', label: 'Contacto' },
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b-2 border-border bg-bg">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-5">
    <a href="#top" class="text-xl font-black tracking-tight text-text">
      JSFranco<span class="text-accent">.dev</span>
    </a>

    <ul class="hidden gap-8 md:flex">
      {
        links.map((link, i) => (
          <li>
            <a
              href={link.href}
              class="link-sweep flex items-center gap-2 font-mono text-sm font-medium tracking-widest text-muted uppercase transition-colors duration-300 hover:text-text"
            >
              <span class="text-accent">0{i + 1}</span>
              <span data-i18n={link.key}>{link.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <div class="hidden items-center gap-2 md:flex">
        <LangToggle />
        <ThemeToggle />
      </div>

      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        data-i18n-aria-label="nav.menuOpenLabel"
        aria-expanded="false"
        class="flex flex-col gap-1.5 p-2 md:hidden"
      >
        <span class="h-px w-6 bg-text transition-transform duration-300"></span>
        <span class="h-px w-6 bg-text transition-opacity duration-300"></span>
        <span class="h-px w-6 bg-text transition-transform duration-300"></span>
      </button>
    </div>
  </nav>

  <ul
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t-2 border-border bg-bg px-6 py-4 md:hidden"
  >
    {
      links.map((link, i) => (
        <li>
          <a
            href={link.href}
            class="flex items-center gap-3 px-2 py-3 font-mono text-sm font-medium tracking-widest text-muted uppercase transition-colors duration-300 hover:text-text"
          >
            <span class="text-accent">0{i + 1}</span>
            <span data-i18n={link.key}>{link.label}</span>
          </a>
        </li>
      ))
    }
    <li class="mt-2 flex items-center gap-2 px-2 pt-3">
      <LangToggle />
      <ThemeToggle />
    </li>
  </ul>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('flex');
    menu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      menu.classList.add('hidden');
      menu.classList.remove('flex');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
