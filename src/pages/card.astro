---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import LangToggle from '../components/LangToggle.astro';

const email = 'javierfranco0904@gmail.com';
const linkedin = 'https://www.linkedin.com/in/jsfranco-dev';
const github = 'https://github.com/JSFranco96';

const links = [
  { href: `mailto:${email}`, key: 'card.emailLabel', label: 'Email', value: email, external: false },
  { href: linkedin, key: 'card.linkedinLabel', label: 'LinkedIn', value: 'jsfranco-dev', external: true },
  { href: github, key: 'card.githubLabel', label: 'GitHub', value: 'JSFranco96', external: true },
  { href: 'https://jsfranco.dev', key: 'card.webLabel', label: 'Web', value: 'jsfranco.dev', external: true },
];
---

<Layout
  title="Javier Steven Franco Ospina — Tarjeta de contacto"
  description="Tarjeta de contacto digital de Javier Steven Franco Ospina, Full-Stack Developer."
>
  <main class="mx-auto flex min-h-screen w-full max-w-md flex-col justify-center gap-8 px-6 py-16">
    <div class="flex items-center justify-between">
      <a href="/" class="text-lg font-black tracking-tight text-text">
        JSFranco<span class="text-accent">.dev</span>
      </a>
      <div class="flex items-center gap-2">
        <LangToggle />
        <ThemeToggle />
      </div>
    </div>

    <div class="flex flex-col items-center gap-5 border-2 border-border bg-bg-soft px-8 py-10 text-center">
      <div
        class="flex h-20 w-20 items-center justify-center border-2 border-border bg-bg font-mono text-xl font-bold tracking-widest text-text"
        aria-hidden="true"
      >
        JSF
      </div>
      <div>
        <h1 class="text-2xl font-black tracking-tight text-text" data-i18n="card.title">
          Javier Steven Franco Ospina
        </h1>
        <p
          class="mt-2 font-mono text-xs font-medium tracking-[0.25em] text-accent uppercase"
          data-i18n="card.role"
        >
          Full-Stack Developer
        </p>
      </div>

      <a
        href="/contact.vcf"
        download="javier-franco.vcf"
        class="group flex w-full items-center justify-center gap-2 bg-text px-6 py-4 text-base font-bold tracking-wide text-bg transition-colors duration-300 hover:bg-accent hover:text-on-accent"
        data-i18n="card.saveContact"
      >
        Guardar contacto
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M12 4v12m0 0l-5-5m5 5l5-5M5 20h14" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    </div>

    <div class="flex flex-col border-2 border-border">
      {
        links.map((link, i) => (
          <a
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
            class={`group flex items-center justify-between px-5 py-4 transition-colors duration-300 hover:bg-bg-soft hover:text-accent ${i > 0 ? 'border-t-2 border-border' : ''}`}
          >
            <div>
              <p class="font-mono text-xs tracking-[0.2em] text-muted uppercase" data-i18n={link.key}>
                {link.label}
              </p>
              <p class="mt-1 text-base font-bold text-text">{link.value}</p>
            </div>
            <svg class="h-4 w-4 shrink-0 text-muted transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1 group-hover:text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </a>
        ))
      }
    </div>

    <div class="flex flex-col items-center gap-3 pt-2">
      <div class="border-2 border-border bg-bg p-2">
        <img src="/card-qr.png" alt="QR" width="120" height="120" class="block" />
      </div>
      <p class="font-mono text-xs tracking-wide text-muted" data-i18n="card.qrCaption">
        Escanea para volver a esta tarjeta
      </p>
    </div>

    <a
      href="/"
      class="link-sweep mx-auto font-mono text-xs font-medium tracking-[0.2em] text-muted uppercase transition-colors duration-300 hover:text-text"
      data-i18n="card.backHome"
    >
      Ir al sitio completo
    </a>
  </main>
</Layout>
