---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { projects } from '../../data/projects';
import { translations } from '../../i18n/translations';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const labels = translations.es.caseStudies;
const cs = labels[project.slug];
const key = `caseStudies.${project.slug}`;
---

<Layout title={cs.meta.title} description={cs.meta.description} i18nMeta={`${key}.meta`}>
  <Nav />
  <main class="pt-20">
    <header class="mx-auto max-w-6xl border-b-2 border-border px-6 py-20 sm:py-28">
      <a
        href="/#projects"
        class="hero-in group inline-flex items-center gap-2 font-mono text-sm tracking-widest text-muted uppercase transition-colors duration-300 hover:text-text"
        style="--stagger: 0"
      >
        <svg class="h-4 w-4 transition-transform duration-300 group-hover:-translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M19 12H5M11 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        <span data-i18n="caseStudies.back">{labels.back}</span>
      </a>

      <p class="hero-in mt-12 font-mono text-sm tracking-[0.3em] text-accent uppercase" style="--stagger: 1" data-i18n={`${key}.tag`}>{cs.tag}</p>
      <h1 class="hero-in mt-4 text-6xl leading-none font-black tracking-tight text-text sm:text-8xl" style="--stagger: 2" data-i18n={`${key}.title`}>
        {cs.title}
      </h1>
      <div class="hero-in mt-8 flex gap-6" style="--stagger: 3">
        <div class="w-[3px] shrink-0 bg-accent"></div>
        <p class="max-w-3xl text-xl leading-relaxed text-muted sm:text-2xl" data-i18n={`${key}.summary`}>{cs.summary}</p>
      </div>

      <dl class="hero-in mt-14 grid gap-px border-2 border-border bg-border sm:grid-cols-2 lg:grid-cols-4" style="--stagger: 4">
        <div class="bg-bg p-6">
          <dt class="font-mono text-xs tracking-[0.2em] text-muted uppercase" data-i18n="caseStudies.roleLabel">{labels.roleLabel}</dt>
          <dd class="mt-2 leading-relaxed text-text" data-i18n={`${key}.role`}>{cs.role}</dd>
        </div>
        <div class="bg-bg p-6">
          <dt class="font-mono text-xs tracking-[0.2em] text-muted uppercase" data-i18n="caseStudies.statusLabel">{labels.statusLabel}</dt>
          <dd class="mt-2 leading-relaxed text-text" data-i18n={`${key}.status`}>{cs.status}</dd>
        </div>
        <div class="bg-bg p-6">
          <dt class="font-mono text-xs tracking-[0.2em] text-muted uppercase" data-i18n="caseStudies.stackLabel">{labels.stackLabel}</dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-2">
              {project.stack.map((tech) => <li class="border border-border-soft px-2 py-1 font-mono text-xs text-muted">{tech}</li>)}
            </ul>
          </dd>
        </div>
        <div class="bg-bg p-6">
          <dt class="font-mono text-xs tracking-[0.2em] text-muted uppercase" data-i18n="caseStudies.linksLabel">{labels.linksLabel}</dt>
          <dd class="mt-2 flex flex-col gap-1">
            {
              project.links.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="link-sweep self-start font-bold break-all text-text hover:text-accent">
                  {link.label} ↗
                </a>
              ))
            }
          </dd>
        </div>
      </dl>
    </header>

    <div class="mx-auto max-w-6xl px-6 py-12 sm:py-16">
      {
        cs.sections.map((section, i) => (
          <section class="reveal grid grid-cols-1 gap-3 border-b-2 border-border py-12 sm:grid-cols-[88px_1fr] sm:gap-8 last:border-b-0" style="--stagger: 0">
            <span class="font-mono text-4xl font-black text-accent">0{i + 1}</span>
            <div class="max-w-3xl">
              <h2 class="text-3xl font-bold tracking-tight text-text sm:text-4xl" data-i18n={`${key}.sections.${i}.heading`}>
                {section.heading}
              </h2>
              {section.body.map((paragraph, j) => (
                <p class="mt-5 text-lg leading-relaxed text-muted" data-i18n={`${key}.sections.${i}.body.${j}`}>{paragraph}</p>
              ))}
              {section.bullets.length > 0 && (
                <ul class="mt-6 flex flex-col gap-4">
                  {section.bullets.map((bullet, j) => (
                    <li class="flex gap-4 text-lg leading-relaxed text-muted">
                      <span class="mt-3 h-[3px] w-4 shrink-0 bg-accent" aria-hidden="true" />
                      <span data-i18n={`${key}.sections.${i}.bullets.${j}`}>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>
        ))
      }
    </div>

    <section class="bg-text text-bg">
      <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-8 px-6 py-20 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-4xl font-black tracking-tight sm:text-5xl" data-i18n="caseStudies.ctaTitle">{labels.ctaTitle}</h2>
          <p class="mt-3 text-lg text-bg/70" data-i18n="caseStudies.ctaText">{labels.ctaText}</p>
        </div>
        <a
          href="/#contact"
          class="group flex shrink-0 items-center gap-2 bg-accent px-7 py-4 text-base font-bold tracking-wide text-on-accent transition-colors duration-300 hover:bg-bg hover:text-text"
        >
          <span data-i18n="caseStudies.ctaButton">{labels.ctaButton}</span>
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
